{
  "name": "scooby-site-tools",
  "private": true,
  "scripts": {
    "community:inventory": "node tools/build-community-library.cjs --dry-run",
    "community:build": "node tools/build-community-library.cjs",
    "community:menus": "node tools/build-menu-resources.cjs",
    "resources:check": "node tools/resource-sync.cjs --check",
    "resources:sync": "node tools/resource-sync.cjs",
    "resources:watch": "node tools/resource-sync.cjs --watch",
    "resources:refresh": "node tools/resource-sync.cjs --refresh-public",
    "resources:pages": "node tools/resource-pages.cjs",
    "resources:seo": "node tools/build-resource-seo.cjs",
    "test:resources": "node --test tools/resource-seo.test.cjs tools/resource-sync.test.cjs",
    "test:community": "node --test tools/community.test.cjs tools/community-menu.test.cjs",
    "tf2:check": "node tools/check-tf2-features.js && node tools/build-tf2-docs.js --check",
    "tf2:build": "node tools/features/build-features-page.js --only tf2 --apply && node tools/build-tf2-docs.js",
    "tf2:test": "node tools/validate-tf2.js && node tools/validate-tf2-docs.js",
    "start": "node tools/preview.cjs",
    "build": "node tools/package-site.cjs",
    "test:site": "node --test tools/site-layout.test.cjs",
    "test:seo": "node --test tools/seo.test.js",
    "seo:links": "node tools/seo-links.js --apply",
    "media:build": "node tools/build-reseller-media.cjs",
    "media:banners": "node tools/render-reseller-banners.cjs",
    "test:reseller": "node --test tools/reseller-program.test.cjs",
    "docs:rockstar": "node tools/build-rockstar-lua-docs.cjs",
    "docs:rockstar:check": "node tools/build-rockstar-lua-docs.cjs --check",
    "docs:rockstar:test": "node tools/validate-rockstar-lua-docs.cjs"
  },
  "devDependencies": {
    "marked": "17.0.5",
    "playwright": "1.62.1"
  }
}
