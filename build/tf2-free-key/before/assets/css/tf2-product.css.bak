/* TF2 uses the shared product layout, gallery, purchase card and feature sections. */
.tf2-tags{display:flex;flex-wrap:wrap;gap:8px;list-style:none;padding:0;margin:-12px 0 30px}.tf2-tags li{padding:6px 11px;border:1px solid var(--border-color);border-radius:6px;font-size:12px;color:var(--text-secondary)}
.tf2-edition-art{display:flex;align-items:center;justify-content:center;min-height:96px;margin-bottom:20px}.tf2-edition-art img{width:100%;max-height:96px;object-fit:contain}.tf2-version{display:grid;gap:8px;margin:20px 0 16px}.tf2-version label{font-size:13px;color:var(--text-secondary)}.tf2-version select{width:100%;min-height:44px;padding:10px 12px;border:1px solid var(--border-color);border-radius:8px;color:var(--text-primary);background:var(--bg-primary);font:inherit}.tf2-version select:focus-visible{outline:2px solid var(--product-accent);outline-offset:3px}.tf2-edition-copy{margin-bottom:22px}.tf2-edition-copy h2{font-size:16px;margin:0 0 8px}.tf2-edition-copy p{font-size:13px;line-height:1.65;color:var(--text-secondary)}
.tf2-product .screenshot-item{text-decoration:none}.tf2-product .lightbox figure{margin:0;max-width:90vw}.tf2-product .lightbox figure img{display:block;max-width:100%;max-height:82vh;object-fit:contain;margin:auto}.tf2-product .lightbox figcaption{max-width:900px;margin:14px auto 0;text-align:center;color:#eee;line-height:1.6;font-size:14px}.tf2-product .lightbox-nav{font-size:36px}
@media(max-width:480px){.tf2-product .product-section-heading{align-items:start;flex-direction:column}.tf2-product .lightbox figure{max-width:100vw}.tf2-product .lightbox figcaption{padding:0 18px;font-size:12px}}
