/* Shared product presentation, based on The Last of Us product page.
   Gallery grids, image sizing and lightboxes remain owned by each product. */
.product-detail {
    --product-accent: #cadba0;
    --product-accent-hover: #deebbd;
    background: var(--bg-primary);
}
.product-detail .main-content { max-width:1240px; padding:140px 20px 60px; }
.product-heading { display:flex; align-items:center; flex-wrap:wrap; gap:16px; margin-bottom:18px; }
.product-heading h1 { margin:0; color:#f4f5ed; font-size:clamp(28px,4vw,42px); line-height:1.15; letter-spacing:-.035em; }
.product-heading-badges { display:flex; flex-wrap:wrap; gap:8px; }
.product-status { padding:6px 12px; border:1px solid #4ade8044; border-radius:6px; background:#4ade801a; color:#9ee6b4; font-size:12px; font-weight:700; }
.product-status.pending { color:#e9c88d; background:#e9c88d12; border-color:#e9c88d40; }
.product-status.neutral { color:#cdd6e5; background:#cdd6e510; border-color:#cdd6e52a; }
.product-intro { max-width:850px; margin:0 0 32px; font-size:14px; line-height:1.8; color:var(--text-secondary); }
.product-eyebrow { font-size:11px; letter-spacing:.18em; font-weight:700; color:var(--product-accent); }
.product-detail .content-grid { grid-template-columns:minmax(0,2fr) minmax(0,1fr); gap:30px; align-items:start; }
.product-detail .screenshots-section { min-width:0; padding:22px; background:var(--bg-card); border:1px solid var(--border-color); border-radius:16px; }
.product-section-heading { display:flex; align-items:end; justify-content:space-between; gap:20px; margin-bottom:24px; }
.product-detail .product-section-heading .section-title { margin:10px 0 0; letter-spacing:-.02em; font-size:1.1rem; }
.product-section-heading>a { color:var(--product-accent); font-size:13px; white-space:nowrap; text-decoration:none; }
.product-section-heading>a:hover { text-decoration:underline; text-underline-offset:4px; }
.product-detail .sidebar { position:static; min-width:0; }
.product-detail .purchase-card { max-width:none; padding:24px; border-radius:16px; background:var(--bg-card); border:1px solid var(--border-color); }
.product-detail .price, .product-detail .free-price-tag { color:var(--product-accent); -webkit-text-fill-color:currentColor; background:none; }
.product-detail .purchase-btn:not(.secondary) { background:var(--product-accent); color:#192114; border-color:var(--product-accent); box-shadow:none; }
.product-detail .purchase-btn:not(.secondary):hover { background:var(--product-accent-hover); color:#192114; transform:translateY(-2px); }
.product-detail .purchase-btn.secondary { background:transparent; border:1px solid var(--border-color); color:var(--text-primary); }
.product-detail .purchase-btn.secondary:hover { border-color:var(--product-accent); background:#cadba00a; }
.product-detail .features-list svg { color:var(--product-accent); }
.product-detail .description-section, .product-detail .video-section { padding:30px; background:var(--bg-card); border:1px solid var(--border-color); border-radius:16px; }
.product-detail .description-content { color:#b5bdb1; }
.product-detail .description-content>p { line-height:1.8; }
.product-detail .product-feature-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:30px; margin-top:32px; }
.product-feature-grid>section { min-width:0; }
.product-detail .product-feature-grid h3 { margin:0 0 12px; font-size:18px; color:#e5eccf; }
.product-detail .product-feature-grid p, .product-detail .product-feature-grid li { font-size:14px; line-height:1.8; color:#b5bdb1; }
.product-detail .product-feature-grid ul, .product-detail .product-feature-grid ol { padding-left:20px; }
.product-detail .product-feature-grid li { margin-bottom:10px; }
.product-detail .description-content a { color:var(--product-accent); text-underline-offset:3px; }
.product-detail .description-content .gmod-setup, .product-detail .description-content .gmod-faq { margin-top:32px; }
.product-addon-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(min(100%,300px),1fr)); gap:24px; }
.product-addon-actions { flex-wrap:wrap; }
.product-addon-actions>a { min-width:120px; }
.product-detail .footer { margin-top:0; }
.product-detail a:focus-visible, .product-detail button:focus-visible, .product-detail summary:focus-visible { outline:2px solid var(--product-accent); outline-offset:5px; }
.product-skip-link { position:fixed; top:-100px; left:20px; z-index:9999; background:var(--product-accent); color:#15200e; padding:14px; }
.product-skip-link:focus { top:15px; }

/* Match the reference's navigation, including its bounded mobile dropdown. */
.product-detail #product-nav { position:fixed; padding:16px; background:transparent; }
#product-nav .nav-inner { position:relative; }
#product-nav .nav-download { margin-left:auto; }
#product-nav .btn-nav-primary { color:#fff; }
.product-detail #product-nav.scrolled { padding-top:10px; padding-bottom:10px; }
.product-detail .free-safety-notice { margin:0 0 30px; border:1px solid #705127; border-radius:12px; }
.product-detail .free-safety-notice>div { padding:15px 20px; }
.product-detail .included-product-card, .product-detail .how-it-works, .product-detail .important-notes { background:var(--bg-card); border-color:var(--border-color); }
.product-detail .included-product-card h3, .product-detail .included-product-card .card-link { color:var(--product-accent); }

@media(max-width:1024px) {
    .product-detail .content-grid { grid-template-columns:minmax(0,1fr); }
    .product-detail .sidebar { grid-row:auto; }
    .product-detail .purchase-card { position:static; }
}
@media(max-width:980px) {
    .product-detail .product-feature-grid { grid-template-columns:repeat(2,minmax(0,1fr)); }
    #product-nav .nav-inner { flex-wrap:nowrap; gap:12px; padding:10px 16px; }
    #product-nav .hamburger { display:flex; order:2; min-width:44px; min-height:44px; align-items:center; justify-content:center; }
    #product-nav .nav-links { display:none; position:absolute; inset:calc(100% + 10px) 0 auto; flex-direction:column; flex-wrap:nowrap; align-items:stretch; gap:4px; padding:12px; max-height:calc(100dvh - 116px); overflow-y:auto; background:rgba(10,10,15,.98); border:1px solid var(--border-color); border-radius:18px; box-shadow:0 16px 36px #0006; }
    #product-nav .nav-links.mobile-open { display:flex; }
    #product-nav .nav-links li { width:100%; text-align:center; }
    #product-nav .nav-links a { display:block; padding:14px 20px; }
    #product-nav .nav-download { margin-left:0; }
    #product-nav .hamburger[aria-expanded="true"] span:nth-child(1) { transform:translateY(7px) rotate(45deg); }
    #product-nav .hamburger[aria-expanded="true"] span:nth-child(2) { opacity:0; }
    #product-nav .hamburger[aria-expanded="true"] span:nth-child(3) { transform:translateY(-7px) rotate(-45deg); }
}
@media(max-width:600px) {
    .product-detail .main-content { padding:120px 18px 40px; }
    .product-heading { gap:12px; }
    .product-intro { font-size:13px; margin-bottom:24px; }
    .product-section-heading { align-items:start; flex-direction:column; gap:14px; }
    .product-detail .product-feature-grid { grid-template-columns:1fr; gap:24px; }
    .product-detail .screenshots-section { padding:20px 16px; }
    .product-detail .description-section, .product-detail .video-section { padding:24px 20px; }
    .product-detail .purchase-card { padding:24px 20px; }
}
@media(prefers-reduced-motion:reduce) {
    .product-detail * { animation:none!important; transition:none!important; scroll-behavior:auto!important; }
}

/* Native disclosure controls keep setup answers available without JavaScript. */
.product-detail .product-faq { margin-top:32px; padding-top:24px; border-top:1px solid var(--border-color); }
.product-detail .product-faq details { border-top:1px solid var(--border-color); }
.product-detail .product-faq summary { padding:16px 0; color:var(--text-primary); font-weight:600; cursor:pointer; }
.product-detail .product-faq details p { padding:0 0 18px; }
