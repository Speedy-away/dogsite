/* TF2 follows the shared product shell and colors. */
.tf2-heading{display:flex;justify-content:space-between;align-items:flex-end;gap:24px;margin-bottom:26px}.tf2-version{display:grid;gap:9px;min-width:220px}.tf2-version label{font-size:12px;color:var(--text-muted,#aaa);letter-spacing:.06em}.tf2-version select{font:inherit;color:#f4ebdc;background:#211b18;border:1px solid #594332;border-radius:10px;padding:13px 36px 13px 15px;max-width:100%}.tf2-version select:focus-visible{outline:2px solid #d99543;outline-offset:3px}.tf2-hero{position:relative;aspect-ratio:2.5;overflow:hidden;border-radius:18px;border:1px solid #ffffff14;background:#28201a}.tf2-scene{width:100%;height:100%;object-fit:cover;display:block}.tf2-hero:after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,#13101508,#13101538 40%,#131015bf)}.tf2-hero-content{position:absolute;inset:0;z-index:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:24px;padding:28px}.tf2-hero-content>img{width:min(65%,620px);height:auto;max-height:65%;object-fit:contain;filter:drop-shadow(0 4px 16px #0009)}.tf2-hero-caption{display:flex;gap:18px;font-size:11px;letter-spacing:.16em;color:#eadcca}.tf2-details{display:grid;grid-template-columns:1fr 1fr;gap:64px;padding:46px 0}.tf2-details h2,.tf2-feature-section h2{font-size:clamp(25px,3vw,34px);line-height:1.15;margin:12px 0 20px}.tf2-details p,.tf2-features p{color:var(--text-secondary,#a8a5ad);line-height:1.75}.tf2-actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:24px}.tf2-note{font-size:12px;margin-top:22px}.tf2-steps{border-left:1px solid #ffffff14;padding-left:40px}.tf2-steps ol{padding-left:22px;margin:0;display:grid;gap:19px}.tf2-steps li{padding-left:7px;color:#cf8849}.tf2-steps strong{display:block;color:#eee4d8;margin-bottom:4px}.tf2-steps li span{display:block;color:#a8a5ad;font-size:14px;line-height:1.65}.tf2-feature-section{border-top:1px solid #ffffff14;padding:30px 0}.tf2-features{display:grid;grid-template-columns:repeat(3,1fr);gap:26px}.tf2-features article{border:1px solid #ffffff12;border-radius:12px;padding:22px}.tf2-features h3{font-size:17px;margin:0 0 12px}.tf2-features p{font-size:14px;margin:0}.tf2-product .product-status.is-free{color:#e9b275;background:#66422238}.tf2-product .main-content{max-width:1180px}.tf2-product code{overflow-wrap:anywhere}@media(max-width:700px){.tf2-heading{align-items:stretch;flex-direction:column}.tf2-version{min-width:0}.tf2-hero{aspect-ratio:1.6}.tf2-hero-content{padding:12px;gap:12px}.tf2-hero-content>img{width:88%}.tf2-hero-caption{font-size:9px;gap:10px}.tf2-details{grid-template-columns:1fr;gap:30px;padding:30px 0}.tf2-steps{border-left:0;border-top:1px solid #ffffff14;padding:28px 0 0}.tf2-features{grid-template-columns:1fr;gap:12px}.tf2-actions a{width:100%}}

.tf2-resources{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px}.tf2-resources a{padding:25px;border:1px solid #ffffff1c;border-radius:12px;color:#f2e7d8;text-decoration:none;background:#201c19;transition:border-color .15s,background .15s}.tf2-resources a:hover{border-color:#c8894d;background:#2b231d}.tf2-resources a:focus-visible{outline:2px solid #e0a564;outline-offset:4px}.tf2-resources span{font-size:11px;letter-spacing:.1em;color:#d7a56e}.tf2-resources h3{font-size:19px;margin:20px 0 12px}.tf2-resources p{font-size:14px;line-height:1.7;color:#aaa4a1;margin:0}@media(max-width:700px){.tf2-resources{grid-template-columns:1fr}}@media(prefers-reduced-motion:reduce){.tf2-resources a{transition:none}}
